# Development Dockerfile for frontend with Vite hot reload
FROM node:24-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (no cache to ensure fresh install)
RUN npm ci --prefer-offline --no-audit

# The compose file keeps node_modules in a volume that outlives image rebuilds, so sync dependencies on
# every start (a no-op when nothing changed) before running Vite.
# --host 0.0.0.0 allows access from outside the container
CMD ["sh", "-c", "npm install --no-audit --no-fund && npm run dev -- --host 0.0.0.0"]
