# =============================================================================
# Selfhostly Backend - API Server
# =============================================================================
# Universal backend image for both primary and secondary nodes.
#
# Handles:
#   - API endpoints (/api/*)
#   - Authentication (/auth/*) - primary only
#   - Database operations - primary only
#   - Container orchestration
#
# Primary vs Secondary is configured via NODE_IS_PRIMARY environment variable:
#   - Primary (NODE_IS_PRIMARY=true): Runs database, handles auth, is source of truth
#   - Secondary (NODE_IS_PRIMARY=false): No database, no auth, proxies to primary
#
# Frontend is served separately via Dockerfile.frontend
# API routing is handled separately via Dockerfile.gateway
# =============================================================================

# Build Stage
#
# Built with --platform=$BUILDPLATFORM so this stage runs on the machine doing the build, not the target
# (arm64). CGO_ENABLED=0 below means the actual cross-compiling is just GOARCH, which the Go toolchain
# does natively and fast; the slow part was ever running the compiler itself under emulation (QEMU on
# CI's amd64 runners) just because the base image matched the target platform instead of the builder's.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder

WORKDIR /app

# Copy go mod files first (cached unless dependencies change)
COPY go.mod go.sum ./

# Download dependencies (cached layer)
RUN --mount=type=cache,target=/go/pkg/mod go mod download

# Copy only necessary source files (respects .dockerignore)
COPY assets.go ./
COPY docker-compose.prod.yml docker-compose.secondary.yml docker-compose.secondary-direct.yml docker-compose.socket-proxy.yml env.example ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/

# VERSION is the release this image is built from. The server reports it, so the UI knows when an update is
# available, and selfhostlyctl carries it too.
ARG VERSION=dev

# Build backend binary (no CGO needed with modernc.org/sqlite). selfhostlyctl ships in the image because the
# updater container the UI starts runs it: it embeds the compose file of this release.
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build,id=go-build-${TARGETARCH} \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
        -ldflags "-X github.com/selfhostly/internal/buildinfo.Version=${VERSION}" -o selfhostly ./cmd/server && \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
        -ldflags "-X github.com/selfhostly/internal/ctl.Version=${VERSION}" -o selfhostlyctl ./cmd/selfhostlyctl

# Production Stage
FROM alpine:latest

# Install runtime dependencies (including Docker CLI and Compose plugin)
RUN apk add --no-cache ca-certificates tzdata docker-cli docker-cli-compose wget

# Create non-root user with fixed UID/GID (1000) for predictable permissions
# Add to docker group for socket access
RUN set -ex; \
    # Create docker group if it doesn't exist (let system assign GID)
    if ! getent group docker >/dev/null; then \
        addgroup -S docker; \
    fi; \
    # Create selfhostly group if it doesn't exist
    if ! getent group selfhostly >/dev/null; then \
        addgroup -g 1000 -S selfhostly; \
    fi; \
    # Create selfhostly user if it doesn't exist
    if ! getent passwd selfhostly >/dev/null; then \
        adduser -u 1000 -S selfhostly -G selfhostly; \
    fi; \
    # Add selfhostly user to docker group
    addgroup selfhostly docker

WORKDIR /app

# Copy backend binary from builder
COPY --from=builder /app/selfhostly .
COPY --from=builder /app/selfhostlyctl /usr/local/bin/selfhostlyctl

# Create directories with proper permissions
RUN mkdir -p /app/data /app/apps && \
    chown -R selfhostly:selfhostly /app

# Switch to non-root user
USER selfhostly

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8082/api/health || exit 1

# Run the backend
CMD ["./selfhostly"]
